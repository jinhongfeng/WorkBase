{
  "manifest_version": 3,
  "name": "WorkBase 密码库",
  "version": "1.0.1",
  "minimum_chrome_version": "120",
  "description": "在你授权的 HTTPS 网站保存和填充 WorkBase 本地密码库中的账号。",
  "key": "",
  "permissions": ["activeTab", "alarms", "nativeMessaging", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "WorkBase 密码库", "default_popup": "popup.html" }
}
